[gd_scene format=3]

[node name="PartyPanel" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Background" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.07, 0.1, 0.125, 1)

[node name="Title" type="Label" parent="."]
text = "OPENGOLD / Party roster"
autowrap_mode = 2
theme_override_font_sizes/font_size = 28

[node name="Roster" type="ItemList" parent="."]

[node name="Sheet" type="RichTextLabel" parent="."]
theme_override_font_sizes/normal_font_size = 18

[node name="Inventory" type="ItemList" parent="."]

[node name="Portrait" type="TextureRect" parent="."]
expand_mode = 1
stretch_mode = 5
texture_filter = 1

[node name="Status" type="Label" parent="."]
autowrap_mode = 2

[node name="Create" type="Button" parent="."]
text = "Create character"

[node name="Remove" type="Button" parent="."]
text = "Remove member"

[node name="Rejoin" type="Button" parent="."]
text = "Rejoin party"

[node name="Recruit" type="Button" parent="."]
text = "Recruit preview guard"

[node name="Equip" type="Button" parent="."]
text = "Equip selected"

[node name="Unequip" type="Button" parent="."]
text = "Unequip selected"

[node name="Explore" type="Button" parent="."]
text = "Explore New Phlan"

[node name="Combat" type="Button" parent="."]
text = "Party combat"

[node name="Close" type="Button" parent="."]
text = "Back to creator"
