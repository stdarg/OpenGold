[gd_scene format=3]

[node name="CombatDemo" type="CombatView"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Title" type="Label" parent="."]
theme_override_colors/font_color = Color(0.843, 0.706, 0.475, 1)
theme_override_font_sizes/font_size = 27
text = "OPENGOLD / Turn-based combat"

[node name="Subtitle" type="Label" parent="."]
theme_override_font_sizes/font_size = 17
text = "SRD 5.2.1 / Fixed combat profiles\nChoose an action, then click its target. Enter ends your turn."

