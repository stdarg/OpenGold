msgid "Action; 30 feet; up to three creatures add 1d4 to attack rolls and saving throws. Concentration, up to 1 minute."
msgstr "Acción; 30 pies; hasta tres criaturas suman 1d4 a sus tiradas de ataque y salvación. Concentración, hasta 1 minuto."

#: src/OpenGold.Rules.Srd5/src/srd5.cpp:10919 src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "Action; touch; Aberrations, Celestials, Elementals, Fey, Fiends and Undead attack the creature with Disadvantage. Concentration, up to 10 minutes."
msgstr "Acción; toque; las aberraciones, celestiales, elementales, feéricos, infernales y muertos vivientes atacan a la criatura con desventaja. Concentración, hasta 10 minutos."

#: src/OpenGold.Rules.Srd5/src/srd5.cpp:10914
msgid "Action; touch; Constitution save; 2d10 Necrotic damage, half on a success, +1d10 from a level 2 slot."
msgstr "Acción; toque; salvación de Constitución; 2d10 de daño Necrótico, la mitad si la supera, +1d10 con un espacio de nivel 2."

#: src/OpenGold.Rules.Srd5/src/srd5.cpp:10891
msgid "Action; touch; heals 2d8 + Charisma modifier."
msgstr "Acción; toque; cura 2d8 + modificador de Carisma."

#: src/OpenGold.Rules.Srd5/src/srd5.cpp:10904
msgid "Action; touch; heals 2d8 + Wisdom modifier."
msgstr "Acción; toque; cura 2d8 + modificador de Sabiduría."

