#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "1 Sorcery Point: a spell that can take more creatures from a higher slot takes one more."
msgstr "1 punto de hechicería: un conjuro que puede afectar a más criaturas con un espacio superior afecta a una más."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "1 Sorcery Point: allies in your save spell's area succeed and take no half damage."
msgstr "1 punto de hechicería: los aliados en el área de tu conjuro con salvación la superan y no reciben la mitad del daño."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "1 Sorcery Point: change Acid, Cold, Fire, Lightning, Poison or Thunder damage to another of them."
msgstr "1 punto de hechicería: cambia el daño de ácido, frío, fuego, relámpago, veneno o trueno a otro de ellos."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "1 Sorcery Point: double a Concentration spell's duration and gain Advantage to keep it."
msgstr "1 punto de hechicería: duplica la duración de un conjuro de concentración y obtén ventaja para mantenerlo."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "1 Sorcery Point: double a spell's range, or Touch becomes 30 feet."
msgstr "1 punto de hechicería: duplica el alcance de un conjuro, o el toque pasa a 30 pies."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "1 Sorcery Point: reroll a missed spell attack roll."
msgstr "1 punto de hechicería: repite una tirada de ataque de conjuro fallida."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "1 Sorcery Point: reroll your lowest damage dice, up to your Charisma modifier."
msgstr "1 punto de hechicería: repite tus dados de daño más bajos, hasta tu modificador de Carisma."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "2 Sorcery Points: cast an Action spell as a Bonus Action."
msgstr "2 puntos de hechicería: lanza un conjuro de acción como acción adicional."

#: src/OpenGoldBox/godot/locale/dynamic_sources.json:1
msgid "2 Sorcery Points: one target has Disadvantage on its save against the spell."
msgstr "2 puntos de hechicería: un objetivo tiene desventaja en su salvación contra el conjuro."

