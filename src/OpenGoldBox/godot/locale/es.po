#: src/OpenGold.Rules.Srd5/src/character_rules.cpp:74
msgid "A disciplined martial artist. Primary abilities: Dexterity and Wisdom. Hit Die: d8."
msgstr "Un artista marcial disciplinado. Características principales: Destreza y Sabiduría. Dado de golpe: d8."

#: src/OpenGold.Rules.Srd5/src/character_rules.cpp:54
msgid "A fierce warrior. Primary ability: Strength. Hit Die: d12."
msgstr "Un combatiente feroz. Característica principal: Fuerza. Dado de golpe: d12."

#: src/OpenGold.Rules.Srd5/src/character_rules.cpp:66
msgid "A guardian of nature. Primary ability: Wisdom. Hit Die: d8."
msgstr "Un guardián de la naturaleza. Característica principal: Sabiduría. Dado de golpe: d8."

#: src/OpenGold.Rules.Srd5/src/character_rules.cpp:82
msgid "A hunter and wilderness explorer. Primary abilities: Dexterity and Wisdom. Hit Die: d10."
msgstr "Un cazador y explorador de tierras salvajes. Características principales: Destreza y Sabiduría. Dado de golpe: d10."

#: src/OpenGold.Rules.Srd5/src/character_rules.cpp:70
msgid "A master of weapons. Primary ability: Strength or Dexterity. Hit Die: d10."
msgstr "Un maestro de las armas. Característica principal: Fuerza o Destreza. Dado de golpe: d10."

#: src/OpenGoldBox/training_control.h:129
msgid "A miss still deals damage equal to the ability modifier used for the attack."
msgstr "Un fallo inflige igualmente daño igual al modificador de característica usado en el ataque."

#: src/OpenGold.Rules.Srd5/src/character_rules.cpp:98
msgid "A scholar of arcane magic. Primary ability: Intelligence. Hit Die: d6."
msgstr "Un estudioso de la magia arcana. Característica principal: Inteligencia. Dado de golpe: d6."

#: src/OpenGold.Rules.Srd5/src/character_rules.cpp:94
msgid "A spellcaster empowered by a pact. Primary ability: Charisma. Hit Die: d8."
msgstr "Un lanzador de conjuros cuyo poder procede de un pacto. Característica principal: Carisma. Dado de golpe: d8."

#: src/OpenGold.Rules.Srd5/src/character_rules.cpp:90
msgid "A spellcaster with innate magic. Primary ability: Charisma. Hit Die: d6."
msgstr "Un lanzador de conjuros con magia innata. Característica principal: Carisma. Dado de golpe: d6."

#: src/OpenGold.Rules.Srd5/src/character_rules.cpp:62
msgid "A wielder of divine magic. Primary ability: Wisdom. Hit Die: d8."
msgstr "Un portador de magia divina. Característica principal: Sabiduría. Dado de golpe: d8."

