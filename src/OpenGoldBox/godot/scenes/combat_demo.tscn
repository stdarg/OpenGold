[node name="Grip" type="OptionButton" parent="."]
focus_mode = 2

[node name="AdrenalineRush" type="Button" parent="."]
text = "Adrenaline Rush"
visible = false
tooltip_text = "Bonus Action: Dash and gain Temporary HP equal to proficiency bonus. All uses return after a Short or Long Rest."

[node name="ActionSurge" type="Button" parent="."]
text = "Action Surge"
visible = false
tooltip_text = "Action Surge: one additional action, except Magic, on your turn. One use per Short or Long Rest."

