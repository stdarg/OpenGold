[node name="ZoomOut10" type="Button" parent="."]
text = "-10%"
tooltip_text = "Decrease battlefield zoom by 10 percentage points"
[node name="ZoomIn10" type="Button" parent="."]
text = "+10%"
tooltip_text = "Increase battlefield zoom by 10 percentage points"
[node name="ZoomIn100" type="Button" parent="."]
