[gd_scene load_steps=1 format=3]

[node name="RolfTour" type="RolfTourView"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Title" type="Label" parent="."]
theme_type_variation = &"LabelGoldText27"
text = "OPENGOLDBOX  /  Rolf's welcome"

[node name="Location" type="Label" parent="."]
theme_type_variation = &"LabelText19"

[node name="MapTitle" type="Label" parent="."]
theme_type_variation = &"LabelText19"
text = "New Phlan    N ↑"

[node name="MapMode" type="Button" parent="."]
text = "Map: full"

[node name="Coordinates" type="Label" parent="."]
theme_type_variation = &"LabelTealText18"

[node name="Legend" type="Label" parent="."]
theme_type_variation = &"LabelMuted"
text = "Arrow: party & facing\nGold: doors   Teal: visited"

[node name="Speaker" type="Label" parent="."]
theme_type_variation = &"LabelGoldText19"

[node name="Dialogue" type="RichTextLabel" parent="."]
theme_type_variation = &"RichTextLabelDialogueText18"
bbcode_enabled = false
scroll_active = true

[node name="Continue" type="Button" parent="."]
text = "Continue  [Enter]"

[node name="Progress" type="Label" parent="."]
theme_type_variation = &"LabelMuted"

[node name="Movement" type="Label" parent="."]
theme_type_variation = &"LabelMuted"

[node name="Left" type="Button" parent="."]
text = "← Turn"

[node name="Forward" type="Button" parent="."]
text = "↑ Step"

[node name="Right" type="Button" parent="."]
text = "Turn →"

[node name="Restart" type="Button" parent="."]
text = "Replay tour"

[node name="Footer" type="Label" parent="."]
theme_type_variation = &"LabelMutedText14"
text = "Arrow keys: move / turn   •   L: look   •   Original New Phlan scripts and shop stock"

[node name="Choices" type="ItemList" parent="."]
theme_type_variation = &"ItemListText17"
visible = false

[node name="Answer" type="LineEdit" parent="."]
visible = false
max_length = 40

[node name="LeaveShop" type="Button" parent="."]
visible = false
text = "Leave shop"

[node name="Look" type="Button" parent="."]
text = "Look [L]"

[node name="Camp" type="Button" parent="."]
text = "Camp [C]"
tooltip_text = "Run the area's pre-camp check and attempt an eight-hour long rest."

[node name="Inventory" type="Button" parent="."]
text = "Inventory"

[node name="Party" type="Label" parent="."]
theme_type_variation = &"LabelGoldText16"

[node name="InventoryPanel" type="Panel" parent="."]
