[gd_scene format=3]

[node name="SoundBoard" type="SoundBoardView"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Eyebrow" type="Label" parent="."]
theme_type_variation = &"LabelText14Teal"
text = "OPENGOLDBOX / POOL OF RADIANCE"

[node name="Title" type="Label" parent="."]
theme_type_variation = &"LabelText34Gold"
text = "Sound board"

[node name="Subtitle" type="Label" parent="."]
theme_type_variation = &"LabelText17"
text = "19 original effects  /  PC speaker  /  Select a button to play or replay"

