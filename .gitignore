# Native build output
/build/
# A second configuration is needed for the Godot and game checks, which the
# default preset leaves off. Any build-* directory is output, never source.
/build-*/
/win-package/
/mac-package/
/src/OpenGoldBox/godot/.godot/
/src/OpenGoldBox/godot/bin/
/src/OpenGoldBox/godot/data/
/src/OpenGoldBox/godot/export_presets.cfg
/src/OpenGoldBox/godot/settings.cfg
/src/OpenGoldBox/godot/settings.cfg.tmp

# Godot generated state and imports
demos/godot/.godot/
demos/godot/*.tmp
demos/godot/bin/

# Local user data and derived original-game assets
/user-data/
/testdata/local/
*.png

# Newly generated OpenGoldBox portrait artwork (not extracted game assets)
!/data/art/portraits/*.png
!/art/portraits/*.png
!/art/portraits/NPCs/*.png

# Newly generated combat head artwork (not extracted game assets)
!/art/heads/*.png
!/art/heads/sources/*.png

# Splash artwork used by the packaged game
!/art/OpenGoldBoxSplashBackground.png
!/art/OpenGoldBoxEngineLettering.png
!/art/OpenGoldBoxGameLettering.png
!/art/OpenGoldBoxEngineLettering.es.png
!/art/OpenGoldBoxGameLettering.es.png

!/demos/godot/shaders/hqx/hq4x.png

# Claude Code agent worktrees
/.claude/worktrees/
